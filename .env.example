# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
VITE_API_URL=http://localhost:3001

# ─── Local Docker services ─────────────────────────────
DYNAMODB_ENDPOINT=http://localhost:8000
REDIS_URL=redis://localhost:6379

# ─── AI ────────────────────────────────────────────────
USE_MOCK_AI=true

# ─── Email (Mailhog locally, SES in staging/prod) ──────
SMTP_HOST=localhost
SMTP_PORT=1025

# ─── Auth ──────────────────────────────────────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── AWS (leave empty for local dev) ───────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# ─── Integrations (leave empty for local dev) ──────────
JIRA_URL=
JIRA_PAT=
HELPDESK_URL=
HELPDESK_API_KEY=
