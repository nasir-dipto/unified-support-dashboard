# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Web (Vite): base URL for API requests; must match where the API listens.
VITE_API_URL=http://localhost:3001
# Web (Vite): pre-fills the Organization ID field on the login screen (not a secret).
VITE_DEFAULT_ORG_ID=demo-org

# ─── Local Docker services ─────────────────────────────
DYNAMODB_ENDPOINT=http://localhost:8000
REDIS_URL=redis://localhost:6379

# ─── AI ────────────────────────────────────────────────
USE_MOCK_AI=true

# ─── Email (Mailhog locally, SES in staging/prod) ──────
SMTP_HOST=localhost
SMTP_PORT=1025

# ─── Auth (API) ────────────────────────────────────────
# DynamoDB table names (must match CDK outputs in deployed envs).
SUPPORT_USERS_TABLE=support_users
SUPPORT_ROLES_TABLE=support_roles
SUPPORT_TICKETS_TABLE=support_tickets
SUPPORT_TICKET_COMMENTS_TABLE=support_ticket_comments
# WebSocket: local = ws on Express /ws (JWT via ?token=); gateway = stub until API Gateway WebSocket exists.
WS_MODE=local
# Set true only on the SQS webhook Lambda worker (relaxed JWT env for that bundle).
# LAMBDA_WEBHOOK_WORKER=false
# RS256 keys: set PEM in .env.local for dev, or JWT_KEY_SECRET_ARN in AWS (JSON: privateKey, publicKey).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_SECRET_ARN=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ─── AWS (leave empty for local dev) ───────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# ─── Integrations (leave empty for local dev) ──────────
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Webhook HMAC (x-hub-signature-256) using raw body + this secret
JIRA_WEBHOOK_SECRET=
# Org id applied to tickets ingested from Jira webhooks / sync when Jira has no USD org
JIRA_DEFAULT_ORG_ID=demo-org
# Comma-separated project keys to sync/webhook (empty = all projects). Example: SCRUM,TPDI,TRL
JIRA_INCLUDE_PROJECTS=SCRUM,TPDI,TRL
# ─── Helpdesk (ManageEngine SDP Cloud + Zoho OAuth) ───
# API base only (no zohoapis host). Example: https://servicedeskplus.uk/app/itdesk/api/v3
HELPDESK_URL=
# Zoho OAuth (refresh token grant via https://accounts.${ZOHO_DOMAIN}/oauth/v2/token)
ZOHO_DOMAIN=zoho.uk
HD_CLIENT_ID=
HD_CLIENT_SECRET=
HD_REFRESH_TOKEN=
# Org for HD webhook + reconcile (align with Jira default if both feed same tenant)
HD_DEFAULT_ORG_ID=demo-org
# POST /api/webhooks/helpdesk — header x-sdp-webhook-secret must match
HD_WEBHOOK_SECRET=
